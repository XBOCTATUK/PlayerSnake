{
    "geode": "5.9.0",
    "gd": {
        "win": "2.2081",
        "android": "2.2081",
        "mac": "2.2081",
        "ios": "2.2081"
    },
    "id": "xboctatuk.player-snake",
    "name": "Player Snake",
    "version": "v1.1.0",
    "developer": "xboctatuk",
    "description": "This mod adds snake made from player icons.",
	"dependencies": {
		"geode.node-ids": ">=v1.23.3"
	},
    "resources": {
        "sprites": [
            "resources/*.png"
        ]
    },
    "settings": {
        "enabled": {
            "name": "Enabled",
            "type": "bool",
            "default": true
        },
        "player-count": {
            "name": "Icon count",
            "type": "int",
            "default": 3,
			"min": 0,
			"max": 255,
			"control": {
				"slider": true
			}
        },
        "player-distance": {
            "name": "Distance between icons",
            "type": "int",
            "default": 24,
			"min": 1,
			"max": 120,
			"control": {
				"slider": true
			}
        },
        "stop-snake-on-death": {
            "name": "Stop snake on death",
            "type": "bool",
            "default": true
        }
    },
    "tags": [
        "offline",
        "customization",
        "gameplay"
    ]
}